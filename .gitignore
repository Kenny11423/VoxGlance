# ==============================================================================
# OmniTranslator (.gitignore)
# Comprehensive Git ignore rules for Python, AI/ML, Desktop UI, and OS artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Bytecode Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Distribution, Builds & Packaging
# ------------------------------------------------------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 4. Testing, Code Coverage & Linting
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. AI / Deep Learning Models & Heavy Artifacts (> 100MB)
# ------------------------------------------------------------------------------
# Downloaded weights and runtime model engines should not bloat Git repository
models/
checkpoints/
*.onnx
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.engine
*.plan
.cache/
huggingface/
torch_cache/

# ------------------------------------------------------------------------------
# 6. Audio, Video, Screen Captures & Temp Dumps
# ------------------------------------------------------------------------------
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.m4a
*.mp4
*.avi
*.mkv
temp_recordings/
captures/
debug_frames/
scratch/

# ------------------------------------------------------------------------------
# 7. Logs, Debug & Runtime Files
# ------------------------------------------------------------------------------
*.log
logs/
debug/
*.out
*.pid
*.seed

# ------------------------------------------------------------------------------
# 8. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
secrets.yaml
secrets.json
*.pem
*.key

# ------------------------------------------------------------------------------
# 9. IDE, Editor & OS Artifacts
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains PyCharm / IntelliJ
.idea/

# Editors & swap files
*.swp
*.swo
*~
*.bak

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Microsoft Office temporary lock files
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx

# ------------------------------------------------------------------------------
# 10. AI Coding Assistant / Tool Local Data
# ------------------------------------------------------------------------------
.agent/
.gemini/
.impeccable/
.antigravity/
